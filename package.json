{
  "name": "arabic-kit",
  "version": "1.0.0",
  "description": "Zero-dependency Arabic number, digit, date, time and text-stretch formatting for JavaScript and TypeScript.",
  "keywords": [
    "arabic",
    "numbers",
    "digits",
    "date",
    "time",
    "stretch",
    "tatweel",
    "format",
    "rtl",
    "i18n",
    "typescript"
  ],
  "author": "Mohamed Tarek",
  "license": "MIT",
  "repository": "https://github.com/Mohamed-0-Turki/arabic-kit",
  "bugs": "https://github.com/Mohamed-0-Turki/arabic-kit/issues",
  "homepage": "https://github.com/Mohamed-0-Turki/arabic-kit#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./number": {
      "types": "./dist/number/index.d.ts",
      "default": "./dist/number/index.js"
    },
    "./digits": {
      "types": "./dist/digits/index.d.ts",
      "default": "./dist/digits/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "default": "./dist/date/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./stretch": {
      "types": "./dist/stretch/index.d.ts",
      "default": "./dist/stretch/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
